[Unit]
Description=Tested sentinel-access-manager service :-)

Requires=sentinel-access-manager.socket
After=sentinel-access-manager.socket

[Service]
User=services
Group=services

ExecStart=/usr/bin/node /opt/void/sentinel-access-manager/service.js
WorkingDirectory=/srv/srvcs/sentinel-access-manager/

Environment=SOCKETMODE=true
Restart=no

[Install]
WantedBy=multi-user.target
